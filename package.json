{
  "name": "todoapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "check:parse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias.mjs scripts/check-parse.ts",
    "check:mealplan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias.mjs scripts/check-mealplan.ts",
    "check:caldav": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias.mjs scripts/check-caldav.ts",
    "db:generate-sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script 2>/dev/null > schema.sql"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@libsql/client": "^0.17.2",
    "@prisma/adapter-libsql": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@tiptap/extension-image": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-task-item": "^3.22.2",
    "@tiptap/extension-task-list": "^3.22.2",
    "@tiptap/pm": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
