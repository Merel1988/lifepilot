generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NextAuth models for OAuth token storage (Microsoft, Google, etc.)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id             String                 @id @default(cuid())
  title          String
  description    String?
  type           String                 @default("TASK") // TASK, REMINDER, NOTE
  folder         String                 @default("PRIVE") // PRIVE, WERK, JANNIE_MEPPEL
  date           DateTime?
  time           String?                // HH:mm format for reminders
  completed      Boolean                @default(false)
  recurring      Boolean                @default(false)
  recurrenceDays String?                // Comma-separated day numbers: 0=Sun,1=Mon,...,6=Sat e.g. "1,2,3,4"
  completions    RecurrenceCompletion[]
  attachments    Attachment[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model RecurrenceCompletion {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date       String   // ISO date string YYYY-MM-DD
  createdAt  DateTime @default(now())

  @@unique([itemId, date])
}

model Habit {
  id          String            @id @default(cuid())
  name        String
  color       String            @default("#2563eb") // Tailwind blue-600
  frequency   String            @default("DAILY") // DAILY, WEEKDAYS, CUSTOM
  customDays  String?           // Comma-separated day numbers like recurrenceDays
  archived    Boolean           @default(false)
  completions HabitCompletion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

model MealPlan {
  id        String   @id @default(cuid())
  weekStart String   // YYYY-MM-DD of the monday
  data      String   // JSON string of the full plan
  createdAt DateTime @default(now())
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("AVONDETEN") // ONTBIJT, LUNCH, AVONDETEN, OVERIG
  ingredients String?  // Comma-separated or free text
  description String?  // Preparation notes
  servings    Int      @default(4)
  favorite    Boolean  @default(false)
  sourceUrl   String?  // Original URL if imported from link
  source      String?  // "manual", "url", "photo", or mealPlan ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PantryItem {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  data      Bytes    // File stored as binary in SQLite
  createdAt DateTime @default(now())
}

model CalendarFeed {
  id        String   @id @default(cuid())
  name      String                          // e.g. "Werk agenda", "Privé agenda"
  url       String                          // webcal:// or https:// ICS feed URL
  folder    String   @default("PRIVE")      // PRIVE, WERK, JANNIE_MEPPEL
  color     String   @default("#2563eb")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Een agenda-account dat we zelf uitlezen in plaats van een publieke feed.
/// Nodig omdat een gedeelde iCloud-agenda niet te publiceren is door iemand die
/// hem niet zelf heeft aangemaakt: via CalDAV gebruiken we gewoon de toegang die
/// Merel al heeft.
model CalendarAccount {
  id       String @id @default(cuid())
  provider String @default("ICLOUD")
  /// Apple ID (e-mailadres)
  username String
  /// App-specifiek wachtwoord, versleuteld met AUTH_SECRET. Nooit teruggeven in een API-antwoord.
  secret   String
  folder   String @default("PRIVE")
  color    String @default("#6d28d9")
  enabled  Boolean @default(true)

  /// Welke agenda's van dit account meedoen: komma-gescheiden CalDAV-URL's.
  /// Leeg betekent: alle agenda's die we vinden.
  selected String?

  lastSyncAt DateTime?
  /// Laatste fout, zodat een kapotte koppeling zichtbaar is in plaats van stil.
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  email   String?
  address String?

  // Losse velden in plaats van een datum, want een verjaardag zonder
  // geboortejaar moet ook kunnen. Zonder jaar tonen we geen leeftijd.
  birthDay   Int? // 1-31
  birthMonth Int? // 1-12
  birthYear  Int?

  notes String?

  // Elke hoeveel weken wil je contact? Leeg = geen herinnering.
  keepInTouchWeeks Int?
  lastContactAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([birthMonth, birthDay])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
